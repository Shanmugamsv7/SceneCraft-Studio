# The application reads these environment variables; this file is a template.
# Copy values into your shell before starting the server.
PORT=8000
BROLL_DATA_DIR=data/jobs
BROLL_LOCAL_LIBRARY=data/footage-library
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
BROLL_PROVIDER=wikimedia
# Wikimedia Commons is the selected real-footage provider. Set a public contact URL/email for its API User-Agent; no API key is required.
# If WIKIMEDIA_CONTACT is empty, SceneCraft shows BROLL_NOT_CONFIGURED and never substitutes still images or demo graphics.
WIKIMEDIA_CONTACT=
# Optional alternative provider: set BROLL_PROVIDER=pexels and add a valid key.
PEXELS_API_KEY=
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
# Set this to a voice your current ElevenLabs plan allows through the API.
# Free-tier accounts cannot use Voice Library voices via the API.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
MAX_FOOTAGE_BYTES=26214400
MAX_UPLOAD_BYTES=26214400
JOB_WORKERS=2
PROVIDER_TIMEOUT_SECONDS=10
