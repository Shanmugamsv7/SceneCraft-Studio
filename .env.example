# The application reads these environment variables; this file is a template.
# Copy values into your shell before starting the server.
PORT=8000
BROLL_DATA_DIR=data/jobs
BROLL_LOCAL_LIBRARY=data/footage-library
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
BROLL_PROVIDER=mock
# For Wikimedia Commons, set BROLL_PROVIDER=wikimedia and provide a public contact URL/email (no API key).
WIKIMEDIA_CONTACT=
# For existing Pexels API key holders only; new key issuance may be paused.
PEXELS_API_KEY=
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
MAX_FOOTAGE_BYTES=26214400
MAX_UPLOAD_BYTES=26214400
JOB_WORKERS=2
PROVIDER_TIMEOUT_SECONDS=10
